# A projekt környezetfüggő beállításai. Minden érték elhagyható: üresen hagyva az alapérték
# érvényes, és az app HELYI MÓDBAN fut (Firebase és hálózat nélkül, a fiókok a készüléken
# maradnak; fejlesztéshez és bemutatóhoz).
#
# Használat: másold ezt a fájlt .env.local néven (nincs verziókövetve), töltsd ki, amire
# szükséged van, majd indítsd újra a Metrót: npx expo start --clear
#
# Az EXPO_PUBLIC_ kezdetű értékek bekerülnek az appba, bárki kiolvashatja őket.
# Titkos kulcs (pl. Firebase service account) ide se kerüljön!

# --- Valódi Firebase-projekt -------------------------------------------------------------
# A Firebase-konzol webes app-beállításaiból. Ha az API-kulcs meg van adva, az app a valódi
# projektet használja (a webes API-kulcs nem titok: a projektet azonosítja).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Emulátoros és helyi módban üresen a demo projekt: demo-csillagnezo
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# --- Helyi Firebase Auth emulátor (npm run emulators, Java 21 kell hozzá) -----------------
# true = az emulátort használja (erősebb az API-kulcsnál). Alapérték: üres (kikapcsolva)
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=
# A gép IP-címe, amin az emulátor fut. Alapérték: üres, ilyenkor az Expo dev szerver
# címéből derül ki (telefonon is), végső esetben 127.0.0.1
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
# Az Auth emulátor portja. Alapérték: 9099. Ha átírod, a firebase.json
# „emulators.auth.port” értékét is írd át ugyanerre.
EXPO_PUBLIC_FIREBASE_EMULATOR_PORT=

# --- Adatszkriptek (npm run data) — nem kerülnek az appba --------------------------------
# A letöltött fájlok a data-raw mappába kerülnek; ha átírod a forrást, töröld a data-raw-t.
# A Stellarium égi kultúráinak forrása. Alapérték: a v26.3 kiadás
# (https://raw.githubusercontent.com/Stellarium/stellarium/v26.3)
STELLARIUM_RAW=
# A HYG csillagkatalógus CSV-je. Alapérték: a HYG-Database egy rögzített commitja
HYG_URL=
