# Alapértelmezés: HELYI MÓD. Ha minden üres, az app Firebase és hálózat nélkül működik,
# a fiókok a készüléken maradnak (csak fejlesztéshez és bemutatóhoz).
#
# Valódi Firebase-hoz: másold ezt a fájlt .env.local néven (nincs verziókövetve),
# töltsd ki az API-kulcsot és a többi értéket, majd indítsd újra az `npm start`-ot.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# true = a helyi Firebase emulátort használja (npm run emulators, Java 21 kell hozzá)
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=
# Telefonos emulátoros teszthez a gép IP-címe, ha az automatikus felismerés nem működik
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
