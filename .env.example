# Firebase-beállítások. A valódi kulcsokat a .env.local fájlba írd (nincs verziókövetve)!
# Ha az API-kulcs üres, az app a helyi Firebase emulátorhoz csatlakozik (npm run emulators).

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# true = mindig az emulátort használja (valódi kulcsok mellett is)
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=
# Telefonos teszteléshez a gép IP-címe, ha az automatikus felismerés nem működik
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
