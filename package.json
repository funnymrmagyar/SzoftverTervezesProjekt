{
  "name": "csillagnezo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-three/fiber": "9.8.2",
    "astronomy-engine": "^2.1.19",
    "expo": "~58.0.21",
    "expo-asset": "~58.0.19",
    "expo-constants": "~58.0.14",
    "expo-file-system": "~58.0.13",
    "expo-gl": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.28",
    "expo-status-bar": "~58.0.4",
    "firebase": "^12.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:auth": "npx --yes firebase-tools@15 emulators:exec --only auth \"jest --config jest.integration.config.js\"",
    "emulators": "npx --yes firebase-tools@15 emulators:start --only auth",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:web": "expo export --platform web",
    "data:stars": "python3 scripts/build_star_catalog.py",
    "data:cultures": "python3 scripts/import_skycultures.py",
    "data": "npm run data:cultures && npm run data:stars"
  },
  "private": true
}
