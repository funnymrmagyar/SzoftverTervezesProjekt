{
  "name": "csillagnezo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-three/fiber": "^9.8.1",
    "astronomy-engine": "^2.1.19",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-constants": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-gl": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:auth": "npx --yes firebase-tools@15 emulators:exec --only auth \"jest --config jest.integration.config.js\"",
    "emulators": "npx --yes firebase-tools@15 emulators:start --only auth",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:web": "expo export --platform web",
    "data:stars": "python3 scripts/build_star_catalog.py",
    "data:cultures": "python3 scripts/import_skycultures.py",
    "data": "npm run data:cultures && npm run data:stars"
  },
  "private": true
}
